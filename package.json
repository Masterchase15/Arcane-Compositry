{
  "name": "arcane-compositry-companion",
  "version": "0.1.0",
  "description": "Companion site for the Dungeons & Dragons: Arcane Compositry expansion - rules codex, spellcrafting calculators, spell indexes and character sheets.",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc",
    "js-types": "node scripts/js-types.js",
    "make-admin": "node scripts/make-admin.js",
    "check-data": "node scripts/check-spells.js",
    "check-spells": "node scripts/check-spells.js",
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "motion": "12.43.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
